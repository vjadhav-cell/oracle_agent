# MCP server (YARN tools)
MCP_URL=http://127.0.0.1:8080/mcp
MCP_TIMEOUT=30

# Streaming
STREAMING_APP_INSTANCE_LIMIT=3

# LiteLLM Proxy (OpenAI-compatible /v1; model = proxy model_name alias)
# Use either naming style; agent-util shared_litellm uses LITELLM_SERVER_URL + DEFAULT_MODEL.
LITELLM_API_BASE=http://litellm-host:4000
# LITELLM_SERVER_URL=https://litellm-host:4000/v1
LITELLM_API_KEY=sk-your-key
LITELLM_MODEL=gemma4
# DEFAULT_MODEL=gemini-2.5-flash
AGENT_TEMPERATURE=0
