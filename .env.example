# MCP server (YARN tools) — used by agent-util AgentFactory
MCP_HOST=127.0.0.1
MCP_PORT=8080

# Streaming
STREAMING_APP_INSTANCE_LIMIT=3

# LiteLLM Proxy (OpenAI-compatible /v1; model = proxy model_name alias)
# Use either naming style; agent-util shared_litellm uses LITELLM_SERVER_URL + LITELLM_MODEL.
LITELLM_SERVER_URL=http://litellm-host:4000
# LITELLM_SERVER_URL=https://litellm-host:4000/v1
LITELLM_API_KEY=sk-your-key
LITELLM_MODEL=gemma4
LITELLM_TEMPERATURE=0
